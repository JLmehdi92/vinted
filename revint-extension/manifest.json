{
  "manifest_version": 3,
  "name": "ReVint — Assistant Vinted",
  "version": "1.0.0",
  "description": "Repost, auto-reponse, edition en lot pour vendeurs Vinted.",
  "permissions": [
    "storage",
    "alarms",
    "webRequest",
    "cookies",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://www.vinted.fr/*",
    "https://www.vinted.be/*",
    "https://www.vinted.es/*",
    "https://www.vinted.it/*",
    "https://www.vinted.de/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.pl/*",
    "https://www.vinted.lt/*",
    "https://www.vinted.co.uk/*",
    "https://www.vinted.com/*",
    "https://images1.vinted.net/*",
    "https://images.vinted.net/*",
    "https://images1.vinted.com/*",
    "https://mavmwuyukbesovfionzq.supabase.co/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_popup": "dist/popup/index.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.be/*",
        "https://www.vinted.es/*",
        "https://www.vinted.it/*",
        "https://www.vinted.de/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.pl/*",
        "https://www.vinted.lt/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.com/*"
      ],
      "js": ["dist/content.js", "dist/widget.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.vinted.fr/items/*",
        "https://www.vinted.be/items/*",
        "https://www.vinted.es/items/*",
        "https://www.vinted.it/items/*",
        "https://www.vinted.de/items/*",
        "https://www.vinted.nl/items/*",
        "https://www.vinted.pt/items/*",
        "https://www.vinted.pl/items/*",
        "https://www.vinted.lt/items/*",
        "https://www.vinted.co.uk/items/*",
        "https://www.vinted.com/items/*"
      ],
      "js": ["dist/sell-similar-button.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.vinted.fr/items/new*",
        "https://www.vinted.be/items/new*",
        "https://www.vinted.es/items/new*",
        "https://www.vinted.it/items/new*",
        "https://www.vinted.de/items/new*",
        "https://www.vinted.nl/items/new*",
        "https://www.vinted.pt/items/new*",
        "https://www.vinted.pl/items/new*",
        "https://www.vinted.lt/items/new*",
        "https://www.vinted.co.uk/items/new*",
        "https://www.vinted.com/items/new*"
      ],
      "js": ["dist/form-filler-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.vinted.fr/items/new*",
        "https://www.vinted.be/items/new*",
        "https://www.vinted.es/items/new*",
        "https://www.vinted.it/items/new*",
        "https://www.vinted.de/items/new*",
        "https://www.vinted.nl/items/new*",
        "https://www.vinted.pt/items/new*",
        "https://www.vinted.pl/items/new*",
        "https://www.vinted.lt/items/new*",
        "https://www.vinted.co.uk/items/new*",
        "https://www.vinted.com/items/new*"
      ],
      "js": ["dist/form-filler.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
