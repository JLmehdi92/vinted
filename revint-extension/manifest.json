        "https://www.vinted.ee/items/new*",
        "https://www.vinted.lv/items/new*",
        "https://www.vinted.si/items/new*"
      ],
      "js": ["dist/form-filler-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
